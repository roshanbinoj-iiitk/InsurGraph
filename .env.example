# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional fallback keys (e.g. a second free-tier project/account). Used automatically
# when the primary key is rate-limited or out of quota (HTTP 429).
GEMINI_API_KEY_FALLBACK=
GROQ_API_KEY_FALLBACK=
# OpenAI-compatible local server (LM Studio default)
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
